<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.abans.lk/ontology/abans.owl#"
     xml:base="http://www.abans.lk/ontology/abans.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:abans="http://www.abans.lk/ontology/abans.owl#">
    <owl:Ontology rdf:about="http://www.abans.lk/ontology/abans.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.abans.lk/ontology/abans.owl#availableAt -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#availableAt">
        <owl:inverseOf rdf:resource="http://www.abans.lk/ontology/abans.owl#stocks"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#Showroom"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#contains -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#contains">
        <owl:inverseOf rdf:resource="http://www.abans.lk/ontology/abans.owl#locatedIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasBrand -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasBrand">
        <owl:inverseOf rdf:resource="http://www.abans.lk/ontology/abans.owl#isBrandOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#Brand"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasEnergyRating -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasEnergyRating">
        <owl:inverseOf rdf:resource="http://www.abans.lk/ontology/abans.owl#isEnergyRatingOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasFeature -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasFeature">
        <owl:inverseOf rdf:resource="http://www.abans.lk/ontology/abans.owl#isFeatureOf"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#isBrandOf -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#isBrandOf"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#isEnergyRatingOf -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#isEnergyRatingOf"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#isFeatureOf -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#isFeatureOf"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#locatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Location"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#stocks -->

    <owl:ObjectProperty rdf:about="http://www.abans.lk/ontology/abans.owl#stocks">
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Showroom"/>
        <rdfs:range rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.abans.lk/ontology/abans.owl#hasCapacity -->

    <owl:DatatypeProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasCapacity">
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasPrice -->

    <owl:DatatypeProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasPrice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasScreenSize -->

    <owl:DatatypeProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasScreenSize">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.abans.lk/ontology/abans.owl#hasWarrantyYears -->

    <owl:DatatypeProperty rdf:about="http://www.abans.lk/ontology/abans.owl#hasWarrantyYears">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.abans.lk/ontology/abans.owl#APlusPlusPlusRating -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusPlusRating">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#APlusPlusRating -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusRating">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#APlusRating -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#APlusRating">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#ARating -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#ARating">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#AirConditioner -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#AirConditioner">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#HomeAppliance"/>
        <rdfs:label>Air Conditioners</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#BRating -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#BRating">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#BasicProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#BasicProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.abans.lk/ontology/abans.owl#FullySmartProduct"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <owl:disjointWith rdf:resource="http://www.abans.lk/ontology/abans.owl#FullySmartProduct"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#BluetoothFeature -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#BluetoothFeature">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Feature"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#Brand -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#Brand"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#BudgetProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#BudgetProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.abans.lk/ontology/abans.owl#PremiumProduct"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <owl:disjointWith rdf:resource="http://www.abans.lk/ontology/abans.owl#PremiumProduct"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#BudgetSmartphone -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#BudgetSmartphone">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#SmartMobilePhone"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                        <owl:someValuesFrom rdf:resource="http://www.abans.lk/ontology/abans.owl#SmartFeature"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasPrice"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50000</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#BudgetProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#FullySmartProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#SmartMobilePhone"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#SmartProduct"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#BluetoothFeature"/>
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#SmartFeature"/>
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#WiFiFeature"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#City -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#City">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Location"/>
        <owl:disjointWith rdf:resource="http://www.abans.lk/ontology/abans.owl#Province"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#ColomboAvailableProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#ColomboAvailableProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#availableAt"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Showroom"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#locatedIn"/>
                                        <owl:hasValue rdf:resource="http://www.abans.lk/ontology/abans.owl#Colombo"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#Computer -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#Computer">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:label>Computers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#DesktopAndMonitor -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#DesktopAndMonitor">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Computer"/>
        <rdfs:label>Desktops &amp; Monitors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#EcoFriendlyProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#EcoFriendlyProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasEnergyRating"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusPlusRating"/>
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusRating"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#EnergyRatingPartition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusPlusRating"/>
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusRating"/>
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusRating"/>
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#ARating"/>
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#BRating"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#Feature -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#Feature"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#FeaturePhone -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#FeaturePhone">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#MobileDevice"/>
        <rdfs:label>Feature Phones</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#FullyLoadedProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#FullyLoadedProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#FullySmartProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#FullySmartProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#Product"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#BluetoothFeature"/>
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#SmartFeature"/>
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#WiFiFeature"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#HomeAppliance -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#HomeAppliance">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:label>Home Appliances</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#InverterFeature -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#InverterFeature">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Feature"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#InverterHomeAppliance -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#InverterHomeAppliance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#HomeAppliance"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasEnergyRating"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusPlusRating"/>
                                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#APlusPlusRating"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                        <owl:someValuesFrom rdf:resource="http://www.abans.lk/ontology/abans.owl#InverterFeature"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#BasicProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#EcoFriendlyProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#HomeAppliance"/>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#LEDTV -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#LEDTV">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#TV"/>
        <rdfs:label>LED TV</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#Laptop -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#Laptop">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Computer"/>
        <rdfs:label>Laptops</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#Location -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#Location"/>
    


    <!-- http://www.abans.lk/ontology/abans.owl#MobileDevice -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#MobileDevice">
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#Product"/>
        <rdfs:label>Mobile Phones &amp; Devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#OLEDTV -->

