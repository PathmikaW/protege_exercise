    <!-- http://www.abans.lk/ontology/abans.owl#PremiumAppleProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#PremiumAppleProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#MobileDevice"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                        <owl:someValuesFrom rdf:resource="http://www.abans.lk/ontology/abans.owl#SmartFeature"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasBrand"/>
                        <owl:hasValue rdf:resource="http://www.abans.lk/ontology/abans.owl#Apple"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasPrice"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">200000</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#FullySmartProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#MobileDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#PremiumProduct"/>
        <rdfs:subClassOf rdf:resource="http://www.abans.lk/ontology/abans.owl#SmartProduct"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.abans.lk/ontology/abans.owl#hasFeature"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#BluetoothFeature"/>
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#SmartFeature"/>
                            <rdf:Description rdf:about="http://www.abans.lk/ontology/abans.owl#WiFiFeature"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.abans.lk/ontology/abans.owl#PremiumProduct -->

    <owl:Class rdf:about="http://www.abans.lk/ontology/abans.owl#PremiumProduct">
