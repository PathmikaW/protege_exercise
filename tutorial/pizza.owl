<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/pathmika.w/ontologies/2026/7/untitled-ontology-6/"
     xml:base="http://www.semanticweb.org/pathmika.w/ontologies/2026/7/untitled-ontology-6/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.pizza.com/ontology/pizza.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasAngle -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasAngle">
        <rdfs:subPropertyOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSide"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#isBaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaBase"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasCountryOfOrigin"/>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasSide -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasSide"/>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasSpiciness -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasSpiciness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.pizza.com/ontology/pizza.owl#SpicinessValuePartition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#isToppingOf"/>
        <rdfs:domain rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaTopping"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#isIngredientOf"/>
        <rdfs:domain rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaBase"/>
        <rdfs:range rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#isIngredientOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.pizza.com/ontology/pizza.owl#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#isIngredientOf"/>
        <rdfs:domain rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaTopping"/>
        <rdfs:range rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.pizza.com/ontology/pizza.owl#AmericanHotPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#AmericanHotPizza">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#JalapenoPepperTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#PepperoniTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Americana + jalapeno</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#AmericanaPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#AmericanaPizza">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#PepperoniTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Margherita + pepperoni</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#AnchovyTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#AnchovyTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#SeafoodTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#CaperTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#CheeseTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#CheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#CheesyPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#Country -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#Country">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#America"/>
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#England"/>
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#France"/>
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#Germany"/>
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#Italy"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#DeepPanBase -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#DeepPanBase">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaBase"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#GrandDipperBase -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#GrandDipperBase">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaBase"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#GreenPepperTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#GreenPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PepperTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#HamTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#HamTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#MeatTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#Hot -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#Hot">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#SpicinessValuePartition"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#InterestingPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#InterestingPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
        <rdfs:comment>A Pizza that has at least 3 distinct toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#JalapenoPepperTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#JalapenoPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PepperTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Hot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#MargheritaPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#MargheritaPizza">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#MeatTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#MeatTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#Medium -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#Medium">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#SpicinessValuePartition"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#Mild -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#Mild">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#SpicinessValuePartition"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#MozzarellaTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#CheeseTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasCountryOfOrigin"/>
                <owl:hasValue rdf:resource="http://www.pizza.com/ontology/pizza.owl#Italy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.pizza.com/ontology/pizza.owl#ParmezanTopping"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#MushroomTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#MushroomTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#NamedPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#NamedPizza">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#NonVegetarianPizza -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#NonVegetarianPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetarianPizza"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#Pizza"/>
        <owl:disjointWith rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetarianPizza"/>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#OliveTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#OliveTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#OnionTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#OnionTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.pizza.com/ontology/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.pizza.com/ontology/pizza.owl#ParmezanTopping -->

    <owl:Class rdf:about="http://www.pizza.com/ontology/pizza.owl#ParmezanTopping">
        <rdfs:subClassOf rdf:resource="http://www.pizza.com/ontology/pizza.owl#CheeseTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.pizza.com/ontology/pizza.owl#hasSpiciness"/>
